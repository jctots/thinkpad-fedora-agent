#!/usr/bin/env bash
# Feed the secret scanner known-bad input and watch the verdict.
#
# The same argument as test/probe, applied to .gitleaks.toml: a config that
# compiles is not a config that works. Both defects found in this repo's rules
# were of the second kind -- one pattern that RE2 could not parse at all, and
# one that parsed fine and could never match, because `^` anchors to the start
# of the scanned fragment without (?m). A config parser catches neither.
#
# The fixture is written to a temp directory at run time and deleted after, so
# no file that looks like a credential is ever committed to a public repo.
#
# Usage:
#   test/secrets-probe          # or: make secrets-probe
#
# Exits nonzero if a rule fails to fire on bad input, or fires on good input.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$REPO_ROOT/.gitleaks.toml"

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "secrets-probe: gitleaks not found -- install it, or let CI run this." >&2
    exit 127
fi

PY="${PYTHON:-}"
if [ -z "$PY" ]; then
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1 && "$c" -c '' >/dev/null 2>&1; then
            PY="$c"; break
        fi
    done
fi
[ -n "$PY" ] || { echo "secrets-probe: no working python found; set PYTHON=" >&2; exit 127; }

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    R=$'\033[31m'; B=$'\033[1m'; X=$'\033[0m'
else
    R=""; B=""; X=""
fi

FIXTURE="$(mktemp -d)"
REPORT="$FIXTURE.json"
trap 'rm -rf "$FIXTURE" "$REPORT"' EXIT

# ---------------------------------------------------------------------------
# Must fire. Every value here is invented and matches only because the rule is
# doing its job. Note the deliberate leading comment lines: a rule anchored
# with `^` and no (?m) passes a one-line fixture and fails a real file.
# ---------------------------------------------------------------------------

cat > "$FIXTURE/connect.sh" <<'EOF'
#!/bin/bash
# bring the laptop onto the house network
nmcli device wifi connect Fritzbox wifi-sec.psk NotARealPresharedKey42
EOF

cat > "$FIXTURE/install.ks" <<'EOF'
# Kickstart for an unattended install.
lang en_GB.UTF-8
keyboard de
rootpw --iscrypted $6$invented$0123456789abcdefghijklmnopqrstuvwxyzABCDEF
user --name=someone --groups=wheel --iscrypted --password=$6$alsoinvented$zyxwvu9876543210
EOF

cat > "$FIXTURE/disk.ks" <<'EOF'
# Partitioning.
autopart --type=btrfs --encrypted --passphrase=NotARealLuksPassphrase
EOF

cat > "$FIXTURE/wg0.conf" <<'EOF'
[Interface]
Address = 10.9.9.2/32
PrivateKey = aB3dEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEf=
EOF

# ---------------------------------------------------------------------------
# Must NOT fire. Placeholders, and the RFC5737 documentation ranges that the
# allowlist exists to permit.
# ---------------------------------------------------------------------------

cat > "$FIXTURE/clean.ks" <<'EOF'
# The committed example: every credential field is a placeholder.
lang en_GB.UTF-8
rootpw --iscrypted PLACEHOLDER_KS_ROOTPW_HASH
user --name=PLACEHOLDER_KS_USER_NAME --groups=wheel --iscrypted --password=PLACEHOLDER_KS_USER_PW_HASH
autopart --type=btrfs --encrypted --passphrase=PLACEHOLDER_LUKS_PASSPHRASE
EOF

cat > "$FIXTURE/clean-docs.md" <<'EOF'
Examples use the documentation ranges, which are not real hosts:
192.0.2.10, 198.51.100.4 and 203.0.113.9.
EOF

# The documented right way. This is what local/README.md shows, and the rule
# flagged it on the first real scan while missing the wrong-way example beside
# it -- a scanner that cries wolf at correct code is one people switch off.
cat > "$FIXTURE/clean-usage.sh" <<'EOF'
#!/bin/bash
. "${REPO_ROOT}/local/secrets.env"
nmcli connection add type wifi ssid "$WIFI_SSID" wifi-sec.psk "$WIFI_PSK"
nmcli device wifi connect "$WIFI_SSID" wifi-sec.psk ${WIFI_PSK}
EOF

# ---------------------------------------------------------------------------

printf '%ssecrets-probe%s  config: %s\n\n' "$B" "$X" "${CONFIG#"$REPO_ROOT"/}"

gitleaks detect --no-git --source "$FIXTURE" --config "$CONFIG" \
    --report-format json --report-path "$REPORT" \
    --redact --no-banner --exit-code 0 >/dev/null 2>&1
rc=$?
if [ "$rc" -ne 0 ]; then
    printf '%sgitleaks exited %s -- it failed to run.%s\n' "$R" "$rc" "$X" >&2
    gitleaks detect --no-git --source "$FIXTURE" --config "$CONFIG" --no-banner >&2
    exit "$rc"
fi

"$PY" - "$REPORT" <<'PY'
import json, pathlib, sys

report = pathlib.Path(sys.argv[1])
findings = json.loads(report.read_text() or "[]")

hits = {}
for f in findings:
    hits.setdefault(f.get("RuleID", "?"), set()).add(pathlib.Path(f.get("File", "")).name)

# rule id -> the fixture file it must be found in
must_fire = {
    "nmcli-wifi-psk":         "connect.sh",
    "kickstart-rootpw":       "install.ks",
    "luks-passphrase":        "disk.ks",
    "wireguard-private-key":  "wg0.conf",
    "homelab-internal-host":  "wg0.conf",
}
must_not_fire = {"clean.ks", "clean-docs.md", "clean-usage.sh"}

failures = []

for rule, want_file in sorted(must_fire.items()):
    files = hits.get(rule, set())
    if want_file in files:
        print(f"  PASS  {rule:<24} fired on {want_file}")
    elif files:
        print(f"  FAIL  {rule:<24} fired, but not on {want_file} (saw {sorted(files)})")
        failures.append(rule)
    else:
        print(f"  FAIL  {rule:<24} did not fire on {want_file}")
        failures.append(rule)

print()
for f in findings:
    name = pathlib.Path(f.get("File", "")).name
    if name in must_not_fire:
        print(f"  FAIL  {f.get('RuleID','?'):<24} fired on {name}, which must stay clean")
        failures.append(name)
for name in sorted(must_not_fire):
    if not any(pathlib.Path(f.get("File", "")).name == name for f in findings):
        print(f"  PASS  {'(no findings)':<24} {name} stayed clean")

print()
if failures:
    print(f"secrets-probe: {len(failures)} failure(s)")
    sys.exit(1)
print("secrets-probe: all rules behave as specified")
PY
