{
  "$comment": [
    "Project-scope settings for a Claude Code session rooted in this repo.",
    "",
    "The hooks below are the enforcement. The deny list is a second layer and",
    "is deliberately redundant with the ruleset: permission rules are prefix",
    "globs and do not survive command chaining, so they catch the plain forms",
    "and the hook catches the rest. Neither is trusted alone.",
    "",
    "There is no auto-approve mode here and there must never be one. Default",
    "(manual) mode is the arrangement that makes real privilege affordable."
  ],

  "permissions": {
    "deny": [
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Read(./local/secrets.env)",

      "Bash(wipefs:*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.*:*)",
      "Bash(blkdiscard:*)",
      "Bash(shred:*)",
      "Bash(sgdisk:*)",
      "Bash(parted:*)",
      "Bash(cryptsetup:*)",
      "Bash(lvremove:*)",
      "Bash(vgremove:*)",
      "Bash(pvremove:*)",
      "Bash(ostree admin undeploy:*)"
    ],

    "ask": [
      "Bash(sudo:*)",
      "Bash(pkexec:*)",
      "Bash(rpm-ostree:*)",
      "Bash(systemctl:*)",
      "Bash(flatpak:*)",
      "Bash(nmcli:*)",
      "Bash(firewall-cmd:*)",
      "Bash(fprintd-enroll:*)",
      "Bash(authselect:*)"
    ],

    "allow": [
      "Bash(rpm-ostree status)",
      "Bash(rpm-ostree db list:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl list-units:*)",
      "Bash(journalctl:*)",
      "Bash(flatpak list:*)",
      "Bash(lsusb:*)",
      "Bash(lspci:*)",
      "Bash(lsblk:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/session-token-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-guard.py\"",
            "statusMessage": "Checking reversibility"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit.py\"",
            "statusMessage": "Audit"
          }
        ]
      }
    ]
  }
}
