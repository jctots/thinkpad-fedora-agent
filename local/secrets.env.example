# Copy to local/secrets.env and fill from Bitwarden. Never commit the filled copy.
# Sourced by scripts that configure something authenticated.

# --- Network -----------------------------------------------------------------
WIFI_SSID="PLACEHOLDER"
WIFI_PSK="PLACEHOLDER"

# --- Install-time (kickstart / VM harness) -----------------------------------
# Generate hashes rather than storing plaintext:
#   python3 -c 'import crypt,getpass; print(crypt.crypt(getpass.getpass(), crypt.mksalt(crypt.METHOD_SHA512)))'
KS_ROOTPW_HASH="PLACEHOLDER"
KS_USER_NAME="PLACEHOLDER"
KS_USER_PW_HASH="PLACEHOLDER"
LUKS_PASSPHRASE="PLACEHOLDER"

# --- Registries and package hosts --------------------------------------------
REGISTRY_URL="PLACEHOLDER"
REGISTRY_USER="PLACEHOLDER"
REGISTRY_TOKEN="PLACEHOLDER"

# --- Home lab ----------------------------------------------------------------
# Not secrets, but they point at a system that is not this laptop.
HOMELAB_HOST="PLACEHOLDER"
HOMELAB_SSH_USER="PLACEHOLDER"

# --- Extras --------------------------------------------------------------
# Not a secret, just machine-local. Absolute path to a private sibling repo
# of your own app installs/config that you don't want in this public repo's
# manifest — a personal app, a work-only tool, anything not every forker
# needs. See docs/extras.md. Leave as PLACEHOLDER (or unset) to skip.
EXTRAS_DIR="PLACEHOLDER"
