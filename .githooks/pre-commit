#!/usr/bin/env bash
# Pre-commit secret scan.
#
# Enable with:  git config core.hooksPath .githooks
# (scripts/install-hooks.sh does this)
#
# This is one of the three guardrails that have to be in place from commit one,
# because retrofitting them means rewriting history.

set -euo pipefail

fail() { printf '\n\033[31mpre-commit: %s\033[0m\n' "$1" >&2; exit 1; }

if ! command -v gitleaks >/dev/null 2>&1; then
    cat >&2 <<'EOF'

pre-commit: gitleaks not found.

This repo is public and commits configuration actions that can carry
credentials as arguments. Install it before committing:

    rpm-ostree install gitleaks     # layered, needs a reboot
    # or, no reboot:
    toolbox run sudo dnf install gitleaks

To commit anyway (you are asserting you have read the diff yourself):

    SKIP_GITLEAKS=1 git commit ...

EOF
    [ "${SKIP_GITLEAKS:-0}" = "1" ] || exit 1
    printf 'pre-commit: gitleaks skipped by SKIP_GITLEAKS=1\n' >&2
    exit 0
fi

printf 'pre-commit: scanning staged changes for secrets...\n'

# Exit 1 means findings. Anything above that means gitleaks itself failed --
# a config that does not compile, an unreadable repo, a panic. Those are not
# the same event and must not print the same message: a malformed regex once
# shipped in this repo for two commits, and reporting that crash as "a secret
# was found" would send you looking for a leak that does not exist.
set +e
gitleaks protect --staged --redact --config .gitleaks.toml --verbose
rc=$?
set -e

if [ "$rc" -eq 1 ]; then
    fail "gitleaks found a secret in the staged changes. Nothing was committed.

Do not fix this by editing the commit. Move the value into local/ and source
it, then restage. If it is a false positive, add a narrow allowlist entry to
.gitleaks.toml in the same commit, so the exception is reviewable."
elif [ "$rc" -ne 0 ]; then
    fail "gitleaks exited $rc -- it failed to run, and scanned nothing.

This is a broken scanner, not a detected secret. Check .gitleaks.toml first;
its regexes are RE2 (Go), which has no lookahead, lookbehind or
backreferences. Run 'make secrets-probe' to exercise the rules directly.

Nothing was committed. Do not work around this with SKIP_GITLEAKS=1 without
reading the staged diff yourself."
fi

printf 'pre-commit: clean\n'

printf 'pre-commit: checking manifest docs for drift...\n'
if ! scripts/check-manifest-docs.sh; then
    fail "a manifest script and scripts/PACKAGES.md have drifted apart (see above).

Add the missing row(s) to scripts/PACKAGES.md in this same commit — that is
the whole point of the doc, and 'make manifest-check' catching it here beats
it going unnoticed the way v4l-utils and nodejs did."
fi
